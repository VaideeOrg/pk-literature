# Copy to .env.local for local dev.

PORT=3006

# Frontend-facing toggle's server-side backstop — same convention as
# terraform/environments/prod/web.tf's COMING_SOON_MODE. Set to "true"
# to actually reach the AI service; defaults off.
FEATURE_AI_BOOKSELLER=false

# Private HTTP address of the ai-service EC2 host (e.g.
# http://10.0.x.x:5000 in prod; point at a local docker-compose up
# instance for dev). No trailing slash.
AI_SERVICE_BASE_URL=http://localhost:5000

# Shared secret this Lambda sends and ai-service/api/server.py checks
# on every request — Secrets Manager-backed in prod
# (terraform/modules/secrets-manager.tf's ai_bookseller_internal_token),
# a plain local value here.
AI_SERVICE_AUTH_TOKEN=dev-only-placeholder
