# Copy to .env for local dev. Never commit a real .env — see .gitignore.

# Matches docker-compose.yml. In deployed environments, DB_AUTH_MODE=iam
# instead, and PGPASSWORD is unused — see database/database.module.ts.
DB_AUTH_MODE=password
PGHOST=localhost
PGPORT=5432
PGDATABASE=pk_literature
PGUSER=pk_literature
PGPASSWORD=pk_literature_local_dev
PGSSL=disable

PORT=3004

# Matches the cdn.<domain> alias the cloudfront Terraform module
# creates. Only used to build public media URLs — see common/media-url.ts.
CDN_BASE_URL=http://localhost:9000

AWS_REGION=ap-southeast-1
EVENTBRIDGE_BUS_NAME=pk-literature-dev

# Razorpay — no real sandbox credentials available in this environment;
# see payments/razorpay.client.ts's own disclosure. Leave unset locally
# unless you have real Razorpay test-mode keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# This one Lambda serves both puthagakadai.com and puthagakadai.sg (one
# backend, two storefronts), so these are keyed per-request, not by a
# single deployment-wide flag — see payments.service.ts's payLater()
# and checkout.service.ts's shippingCostFor() for the full reasoning.
#
# Comma-separated list of X-Market values allowed to use
# POST /payments/pay-later (the zero-gateway "pay on collection"
# option). puthagakadai.com structurally can't match anything here —
# its requests never carry X-Market at all.
PAY_LATER_ENABLED_MARKETS=SG

# Flat shipping cost added to every order (checkout.service.ts).
# SHIPPING_COST is used for every order EXCEPT one priced in SGD (i.e.
# added to cart via X-Market: SG - see cart.service.ts's upsertItem());
# SHIPPING_COST_SG is used for those.
SHIPPING_COST=50
SHIPPING_COST_SG=3
